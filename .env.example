# Poké-Engine environment variables
# Copy this file to .env, then choose either the Emulator or Production settings.

# Optional: HTTP port (defaults to 3000)
PORT=3000

# Environment selection (NODE_ENV defaults to development; FIREBASE_ENV may be inferred from both hosts).
NODE_ENV=development
FIREBASE_ENV=emulator
# Required in Production; set explicitly for predictable Emulator project isolation.
FIREBASE_PROJECT_ID=demo-poke-engine
# Both host variables are required together in Emulator mode and forbidden in Production.
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
FIRESTORE_EMULATOR_HOST=127.0.0.1:8080

# Required in both modes. Replace these with different random values of at least 32 characters.
CSRF_SECRET=replace-with-a-random-value-at-least-32-characters
IDEMPOTENCY_SECRET=replace-with-a-different-random-value-at-least-32-characters

# Optional: comma-separated extra request origins. Local origins are already allowed.
# ALLOWED_ORIGINS=https://your-app.example

# Optional Emulator project-ID fallback only when FIREBASE_PROJECT_ID is unset.
# GCLOUD_PROJECT=your-emulator-project-id

# --- Production alternative ---
# Required in Production: set NODE_ENV=production and FIREBASE_ENV=production.
# Remove or comment out both Emulator host variables above.
# FIREBASE_PROJECT_ID=your-production-project-id
# FIREBASE_WEB_API_KEY=replace-with-your-firebase-web-api-key
# Provide Admin SDK credentials using ONE of these options:
# FIREBASE_SERVICE_ACCOUNT_KEY=C:/secure/path/service-account.json
# GOOGLE_APPLICATION_CREDENTIALS=C:/secure/path/service-account.json
# Keep the Service Account JSON outside the repository. Do not paste JSON or keys here.
